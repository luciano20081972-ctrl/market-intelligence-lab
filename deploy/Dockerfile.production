FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app
WORKDIR /app

COPY pyproject.toml README.md alembic.ini ./
COPY apps ./apps
COPY packages ./packages
COPY migrations ./migrations
COPY scripts ./scripts
COPY config ./config
RUN pip install --no-cache-dir ".[postgres,integrations]"

RUN useradd --create-home --uid 10001 mil \
    && mkdir -p /app/data \
    && chown -R mil:mil /app
USER 10001:0
EXPOSE 8000
CMD ["sh", "-c", "export MIL_DATABASE_URL=$(cat /run/secrets/mil_database_url); exec python scripts/container_start.py"]
