# Public/non-secret production settings. Copy outside the repository and set
# real values through the deployment host's protected configuration path.
MIL_ENVIRONMENT=production
MIL_EXPECTED_SCHEMA_REVISION=a015a0020001
MIL_AUTH_MODE=native
MIL_CORS_ORIGINS=["https://ubuntu-server.tail695c49.ts.net:8443"]
MIL_TRUSTED_HOSTS=["ubuntu-server.tail695c49.ts.net","127.0.0.1","localhost","api","mil-api"]
MIL_RAW_OBJECT_STORE_ROOT=/app/data/raw
MIL_BACKUP_ROOT=/app/data/backups
MIL_SEED_DEMO_DATA=false
MIL_JSON_LOGS=true
MIL_SCHEDULER_ENABLED=true
MIL_MAX_CONCURRENT_INGESTION_JOBS=2
MIL_MAX_CONCURRENT_RESEARCH_JOBS=1
MIL_MAX_JOB_BACKLOG=10000
MIL_RUN_LIVE_SEC_TESTS=false
MIL_RUN_LIVE_WORLD_DATA_TESTS=false
MIL_RUN_LIVE_TWELVE_DATA_TESTS=false
MIL_REQUIRED_LIVE_PROVIDERS=[]
MIL_SEC_USER_AGENT=Market Intelligence Lab operations@example.invalid
MIL_FRED_API_KEY=
MIL_EIA_API_KEY=
MIL_TWELVE_DATA_API_KEY=
MIL_IMAGE_TAG=0.15.0-build-required

# Real-market sources are fail-closed until credentials and network opt-in are approved.
MIL_REFERENCE_NETWORK_ENABLED=false
MIL_MASSIVE_API_KEY=
MIL_MASSIVE_REQUESTS_PER_MINUTE=5
MIL_ALPACA_API_KEY_ID=
MIL_ALPACA_API_SECRET=
MIL_ALPACA_REQUESTS_PER_MINUTE=200
MIL_ALPACA_REALTIME_CAPACITY=30

MIL_AUTH_ALLOWED_ORIGINS=["https://ubuntu-server.tail695c49.ts.net:8443"]
MIL_AUTH_IDLE_SECONDS=1800
MIL_AUTH_ABSOLUTE_SECONDS=28800
